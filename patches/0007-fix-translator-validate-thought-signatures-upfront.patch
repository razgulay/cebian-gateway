+// Bounds for a plausible Google thought signature. Real ones are base64
+// blobs of at least a few hundred bytes; the shipped defaults are 1-4KB.
+// Anything below the floor or above the cap is client-mangled garbage, not
+// a signature Google will accept.
+const (
+	thoughtSigMinEncodedLen = 64
+	thoughtSigMaxEncodedLen = 64 * 1024
+)
+
+// validThoughtSignature reports whether sig has the shape of a real Google
+// thought signature: long enough, short enough, and decodable as standard
+// base64 (padded or raw). Clients round-trip these inside tool_call IDs and
+// are free to mangle them — truncation, "+"→" " rewriting, percent-encoding
+// — and an invalid one reaches Google as "Corrupted thought signature.
+// INVALID_ARGUMENT", 400ing the request. Callers fall back to
+// DefaultThinkingSignature when this returns false.
+func validThoughtSignature(sig string) bool {
+	if len(sig) < thoughtSigMinEncodedLen || len(sig) > thoughtSigMaxEncodedLen {
+		return false
+	}
+	decoded, err := base64.StdEncoding.DecodeString(sig)
+	if err != nil {
+		decoded, err = base64.RawStdEncoding.DecodeString(sig)
+		if err != nil {
+			return false
+		}
+	}
+	return len(decoded) > 0
+}
+
 // stripThoughtSig removes the "__ts__<sig>" suffix the response translator
 // encodes into a tool call ID (see TranslateGeminiResponseToOpenAI). Gemini
 // matches a functionResponse to its functionCall by id, so both sides must
