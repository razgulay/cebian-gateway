index 0000000..c441e85
--- /dev/null
+++ b/internal/translator/gemini_thoughtsig_test.go
@@ -0,0 +1,119 @@
+package translator
+
+import (
+	"encoding/base64"
+	"strings"
+	"testing"
+
+	json "encoding/json/v2"
+)
+
+// Regression tests for the proactive thought-signature sanitizer: a tool_call
+// whose id carries a corrupted (client-mangled) __ts__ payload used to go
+// upstream as-is, and Google answered 400 "Corrupted thought signature.
+// INVALID_ARGUMENT". The reactive 400-retry in proxy.ForwardGemini then
+// replaced every signature with the default and replayed — doubling latency
+// on every corrupted turn. The translator now shape-validates signatures and
+// signs unusable ones with the default BEFORE the request leaves.
+
+func geminiCallSignatures(t *testing.T, openaiBody string) []string {
+	t.Helper()
+	out, err := TranslateOpenAIToGemini([]byte(openaiBody))
+	if err != nil {
+		t.Fatalf("TranslateOpenAIToGemini: %v", err)
+	}
+	var req GeminiRequest
+	if err := json.Unmarshal(out, &req); err != nil {
+		t.Fatalf("unmarshal gemini request: %v", err)
+	}
+	var sigs []string
+	for _, c := range req.Contents {
+		for _, p := range c.Parts {
+			if p.FunctionCall != nil {
+				sigs = append(sigs, p.ThoughtSignature)
+			}
+		}
+	}
+	return sigs
+}
+
+func toolCallBody(ids ...string) string {
+	var b strings.Builder
+	b.WriteString(`{"model":"gemini-3-pro-preview","messages":[{"role":"user","content":"go"},{"role":"assistant","content":null,"tool_calls":[`)
+	for i, id := range ids {
+		if i > 0 {
+			b.WriteString(",")
+		}
+		b.WriteString(`{"id":"` + id + `","type":"function","function":{"name":"fs_read","arguments":"{}"}}`)
+	}
+	b.WriteString(`]},{"role":"tool","tool_call_id":"` + ids[0] + `","content":"[]"}]}`)
+	return b.String()
+}
+
+func TestValidThoughtSignature(t *testing.T) {
+	valid := base64.StdEncoding.EncodeToString(make([]byte, 200))
+	validRaw := base64.RawStdEncoding.EncodeToString(make([]byte, 200))
+	cases := []struct {
+		name string
+		sig  string
+		want bool
+	}{
+		{"valid padded", valid, true},
+		{"valid raw", validRaw, true},
+		{"empty", "", false},
+		{"too short", base64.StdEncoding.EncodeToString([]byte("abc")), false},
+		{"not base64", "not!!base64###", false},
+		{"client space-mangled", strings.ReplaceAll(valid[:80], "A", " ") + valid[80:], false},
+	}
+	for _, tc := range cases {
+		if got := validThoughtSignature(tc.sig); got != tc.want {
+			t.Errorf("%s: validThoughtSignature = %v, want %v", tc.name, got, tc.want)
+		}
+	}
+}
+
+func TestTranslateOpenAIToGemini_ReplacesCorruptedTransportedSignature(t *testing.T) {
+	sigs := geminiCallSignatures(t, toolCallBody("call_abc__ts__not!!base64###"))
+	if len(sigs) != 1 {
+		t.Fatalf("expected 1 functionCall, got %d", len(sigs))
+	}
+	if sigs[0] != DefaultThinkingSignature {
+		t.Fatalf("corrupted signature forwarded upstream: %.40s", sigs[0])
+	}
+}
+
+func TestTranslateOpenAIToGemini_KeepsValidTransportedSignature(t *testing.T) {
+	sig := base64.StdEncoding.EncodeToString(make([]byte, 300))
+	sigs := geminiCallSignatures(t, toolCallBody("call_abc__ts__"+sig))
+	if len(sigs) != 1 {
+		t.Fatalf("expected 1 functionCall, got %d", len(sigs))
+	}
+	if sigs[0] != sig {
+		t.Fatal("valid transported signature was not preserved")
+	}
+}
+
+// The old code defaulted only the FIRST tool call of a message and left the
+// rest unsigned; every call now carries either a validated signature or the
+// known-accepted default (the shape the reactive 400-retry produces).
+func TestTranslateOpenAIToGemini_DefaultsEveryUnsignedToolCall(t *testing.T) {
+	sigs := geminiCallSignatures(t, toolCallBody("call_a", "call_b", "call_c"))
+	if len(sigs) != 3 {
+		t.Fatalf("expected 3 functionCalls, got %d", len(sigs))
+	}
+	for i, sig := range sigs {
+		if sig != DefaultThinkingSignature {
+			t.Errorf("call %d not default-signed: %.40s", i, sig)
+		}
+	}
+}
+
+// Truncated __ts__ payloads (clients that cap id length) must not reach
+// Google either.
+func TestTranslateOpenAIToGemini_ReplacesTruncatedTransportedSignature(t *testing.T) {
+	sig := base64.StdEncoding.EncodeToString(make([]byte, 300))
+	sigs := geminiCallSignatures(t, toolCallBody("call_abc__ts__"+sig[:40]))
+	if len(sigs) != 1 || sigs[0] != DefaultThinkingSignature {
+		t.Fatalf("truncated signature not replaced: %.40s", sigs[0])
+	}
+}
