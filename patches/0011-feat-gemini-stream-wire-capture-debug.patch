 internal/handlers/chat/gemini_handler.go      |  6 ++
 internal/handlers/chat/gemini_stream_debug.go | 81 +++++++++++++++++++
 2 files changed, 87 insertions(+)
 create mode 100644 internal/handlers/chat/gemini_stream_debug.go

