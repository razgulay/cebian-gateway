+// NormalizeGeminiRequest enforces the role contract Google's generateContent
+// endpoints demand — the funnel every Gemini-native payload passes through
+// (TranslateOpenAIToGemini output, WrapForAntigravity re-wrap):
+//
+//   - "system"/"developer"-role contents are hoisted into the top-level
+//     systemInstruction instead of riding inside contents;
+//   - "assistant" is canonicalized to "model"; functionResponse-bearing
+//     contents to "user"; anything unknown to "user";
+//   - then the usual NormalizeGeminiContents cleanup (merge adjacent,
+//     strip empties, first turn user, terminal-model answer turn).
+//
+// Without this a converter regression or a hand-built Gemini body reached
+// Google with a foreign role and drew 400 "Please use a valid role: user,
+// model".
+func NormalizeGeminiRequest(req *GeminiRequest, model string) {
+	if req == nil {
+		return
+	}
+	var sysParts []GeminiPart
+	kept := make([]GeminiContent, 0, len(req.Contents))
+	for _, c := range req.Contents {
+		switch strings.ToLower(c.Role) {
+		case "system", "developer":
+			sysParts = append(sysParts, c.Parts...)
+			continue
+		}
+		kept = append(kept, c)
+	}
+	if len(sysParts) > 0 {
+		if req.SystemInstruction != nil {
+			// Hoisted system text goes BEFORE anything already there: the
+			// caller's explicit instruction outranks a stray role.
+			sysParts = append(sysParts, req.SystemInstruction.Parts...)
+		}
+		req.SystemInstruction = &GeminiContent{Role: "user", Parts: sysParts}
+	}
+	for i := range kept {
+		if kept[i].Role == "" {
+			// No role to reason about — NormalizeGeminiContents drops these,
+			// same as it always has.
+			continue
+		}
+		kept[i].Role = geminiCanonicalRole(kept[i].Role, kept[i].Parts)
+	}
+	req.Contents = NormalizeGeminiContentsForModel(kept, model)
+}
+
+// geminiCanonicalRole maps any incoming role to the two Google accepts.
+func geminiCanonicalRole(role string, parts []GeminiPart) string {
+	for _, p := range parts {
+		if p.FunctionResponse != nil {
+			// A function result is a user-side turn regardless of the label
+			// the converter gave it.
+			return "user"
+		}
+	}
+	switch strings.ToLower(role) {
+	case "model", "assistant":
+		return "model"
+	default:
+		return "user"
+	}
+}
+
+// EnsureGeminiTerminalUserTurn re-establishes, on a fully-built Gemini
+// request body, the guarantee NormalizeGeminiContents enforces after
+// translation: the Gemini and Vertex generateContent endpoints reject a
+// contents array that ends with a model turn ("Requests ending with a model
+// turn are not supported."). Call it on the FINAL wire body — any producer
+// between the translator and the socket (post-processors, request
+// rewriters, client-supplied Gemini bodies) can otherwise resurface the
+// shape. Map-based on purpose: a struct round-trip would drop unknown
+// top-level fields (the vertex post-process role-drop lesson).
+func EnsureGeminiTerminalUserTurn(body []byte) []byte {
+	var doc map[string]jsontext.Value
+	if err := json.Unmarshal(body, &doc); err != nil {
+		return body
+	}
+	raw, ok := doc["contents"]
+	if !ok || !raw.IsValid() {
+		return body
+	}
+	var turns []struct {
+		Role  string         `json:"role"`
+		Parts jsontext.Value `json:"parts"`
+	}
+	if err := json.Unmarshal(raw, &turns); err != nil {
+		return body
+	}
+	if len(turns) == 0 || turns[len(turns)-1].Role != "model" {
+		return body
+	}
+	var lastParts []GeminiPart
+	if err := json.Unmarshal(turns[len(turns)-1].Parts, &lastParts); err != nil {
+		return body
+	}
+	guard, err := json.Marshal(GeminiContent{Role: "user", Parts: geminiTerminalUserParts(lastParts)})
+	if err != nil {
+		return body
+	}
+	var guardTurn struct {
+		Role  string         `json:"role"`
+		Parts jsontext.Value `json:"parts"`
+	}
+	if err := json.Unmarshal(guard, &guardTurn); err != nil {
+		return body
+	}
+	turns = append(turns, guardTurn)
+	out, err := json.Marshal(turns)
+	if err != nil {
+		return body
+	}
+	doc["contents"] = jsontext.Value(out)
+	whole, err := json.Marshal(doc)
+	if err != nil {
+		return body
+	}
+	return whole
+}
+
 // NormalizeGeminiContents merges adjacent same-role messages, strips empty
 // parts, and brackets the conversation with user turns — parity with
 // open-sse/translator/formats/gemini.js. Gemini rejects a contents array that
