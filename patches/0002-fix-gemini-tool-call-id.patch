@@ -177,6 +178,15 @@ func TranslateOpenAIToGemini(openaiBody []byte) ([]byte, error) {
 
 	var req GeminiRequest
 
+	// OpenAI->Gemini runs on raw bodies and never passes through
+	// EnsureToolCallIDs (that repair lives on the Claude path), so an assistant
+	// tool_call or tool message that arrived without an id would emit an
+	// id-less functionCall/functionResponse pair, which Google's
+	// Vertex-Anthropic converter rejects as
+	// "tool_result.tool_use_id: Field required". Repair on the raw JSON so the
+	// typed parse below always sees complete ids.
+	oreq.Messages = repairGeminiToolIDs(oreq.Messages)
+
 	// Parse messages
 	var msgs []struct {
 		Role             string           `json:"role"`
@@ -503,6 +561,69 @@ func geminiCleanToolCallID(id string) string {
 	return id
 }
 
+// repairGeminiToolIDs fills in a missing tool_call_id / tool_calls[].id on a
+// raw OpenAI messages array. Without it an id-less pair reaches Gemini as a
+// functionResponse with no id, and Google's Vertex-Anthropic converter drops
+// tool_use_id and 400s the whole request (PR #4090 parity for the Gemini path).
+func repairGeminiToolIDs(raw jsontext.Value) jsontext.Value {
+	if len(raw) == 0 {
+		return raw
+	}
+	var msgs []map[string]any
+	if err := json.Unmarshal(raw, &msgs); err != nil {
+		return raw
+	}
+	var pending []string
+	seq := 0
+	changed := false
+	for i := range msgs {
+		role, _ := msgs[i]["role"].(string)
+		switch role {
+		case "assistant":
+			tcs, _ := msgs[i]["tool_calls"].([]any)
+			if len(tcs) == 0 {
+				continue
+			}
+			for k := range tcs {
+				tc, _ := tcs[k].(map[string]any)
+				if tc == nil {
+					continue
+				}
+				id, _ := tc["id"].(string)
+				if id == "" {
+					id = fmt.Sprintf("call_%d_%d", seq, k)
+					tc["id"] = id
+					changed = true
+				}
+				pending = append(pending, id)
+			}
+			seq++
+		case "tool":
+			id, _ := msgs[i]["tool_call_id"].(string)
+			if id == "" && len(pending) > 0 {
+				msgs[i]["tool_call_id"] = pending[0]
+				pending = pending[1:]
+				changed = true
+			} else if id != "" {
+				for j, p := range pending {
+					if p == id {
+						pending = append(pending[:j], pending[j+1:]...)
+						break
+					}
+				}
+			}
+		}
+	}
+	if !changed {
+		return raw
+	}
+	out, err := json.Marshal(msgs)
+	if err != nil {
+		return raw
+	}
+	return jsontext.Value(out)
+}
+
 // toolCallIDUniquifier rewrites duplicate tool_call_ids so every emitted
 // functionCall id is unique across the whole request.
 //
