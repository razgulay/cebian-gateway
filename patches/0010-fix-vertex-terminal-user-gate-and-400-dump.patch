 internal/translator/gemini.go                 |  56 +++++++++
 .../translator/gemini_terminal_gate_test.go   | 109 ++++++++++++++++++
 3 files changed, 177 insertions(+)
 create mode 100644 internal/translator/gemini_terminal_gate_test.go

