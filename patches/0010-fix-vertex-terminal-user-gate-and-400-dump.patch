+// EnsureGeminiTerminalUserTurn re-establishes, on a fully-built Gemini
+// request body, the guarantee NormalizeGeminiContents enforces after
+// translation: the Gemini and Vertex generateContent endpoints reject a
+// contents array that ends with a model turn ("Requests ending with a model
+// turn are not supported."). Call it on the FINAL wire body — any producer
+// between the translator and the socket (post-processors, request
+// rewriters, client-supplied Gemini bodies) can otherwise resurface the
+// shape. Map-based on purpose: a struct round-trip would drop unknown
+// top-level fields (the vertex post-process role-drop lesson).
+func EnsureGeminiTerminalUserTurn(body []byte) []byte {
+	var doc map[string]jsontext.Value
+	if err := json.Unmarshal(body, &doc); err != nil {
+		return body
+	}
+	raw, ok := doc["contents"]
+	if !ok || !raw.IsValid() {
+		return body
+	}
+	var turns []struct {
+		Role  string         `json:"role"`
+		Parts jsontext.Value `json:"parts"`
+	}
+	if err := json.Unmarshal(raw, &turns); err != nil {
+		return body
+	}
+	if len(turns) == 0 || turns[len(turns)-1].Role != "model" {
+		return body
+	}
+	var lastParts []GeminiPart
+	if err := json.Unmarshal(turns[len(turns)-1].Parts, &lastParts); err != nil {
+		return body
+	}
+	guard, err := json.Marshal(GeminiContent{Role: "user", Parts: geminiTerminalUserParts(lastParts)})
+	if err != nil {
+		return body
+	}
+	var guardTurn struct {
+		Role  string         `json:"role"`
+		Parts jsontext.Value `json:"parts"`
+	}
+	if err := json.Unmarshal(guard, &guardTurn); err != nil {
+		return body
+	}
+	turns = append(turns, guardTurn)
+	out, err := json.Marshal(turns)
+	if err != nil {
+		return body
+	}
+	doc["contents"] = jsontext.Value(out)
+	whole, err := json.Marshal(doc)
+	if err != nil {
+		return body
+	}
+	return whole
+}
