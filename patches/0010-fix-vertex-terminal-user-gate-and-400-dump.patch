diff --git a/internal/translator/gemini_terminal_gate_test.go b/internal/translator/gemini_terminal_gate_test.go
new file mode 100644
index 0000000..a3299e2
--- /dev/null
+++ b/internal/translator/gemini_terminal_gate_test.go
@@ -0,0 +1,109 @@
+package translator
+
+import (
+	"strings"
+	"testing"
+
+	json "encoding/json/v2"
+	"encoding/json/jsontext"
+)
+
+// The final-gate guarantee: a Gemini request body that ends with a model
+// turn is rejected by the Gemini and Vertex generateContent endpoints
+// ("Requests ending with a model turn are not supported."). The translator
+// normalizes this already; EnsureGeminiTerminalUserTurn re-establishes it on
+// the wire body so nothing between translator and socket can resurface the
+// shape.
+
+func TestEnsureGeminiTerminalUserTurn_AppendsGuardTurn(t *testing.T) {
+	body := []byte(`{"contents":[
+		{"role":"user","parts":[{"text":"go"}]},
+		{"role":"model","parts":[{"functionCall":{"name":"f","id":"call_1","args":{}}}]}
+	]}`)
+	out := EnsureGeminiTerminalUserTurn(body)
+
+	var req struct {
+		Contents []struct {
+			Role  string           `json:"role"`
+			Parts []map[string]any `json:"parts"`
+		} `json:"contents"`
+	}
+	if err := json.Unmarshal(out, &req); err != nil {
+		t.Fatal(err)
+	}
+	if len(req.Contents) != 3 {
+		t.Fatalf("expected 3 contents, got %d: %s", len(req.Contents), out)
+	}
+	last := req.Contents[len(req.Contents)-1]
+	if last.Role != "user" {
+		t.Fatalf("guard turn role %q, want user", last.Role)
+	}
+	if len(last.Parts) != 1 {
+		t.Fatalf("guard parts: %v", last.Parts)
+	}
+	if fr, ok := last.Parts[0]["functionResponse"].(map[string]any); ok {
+		if fr["name"] != "f" {
+			t.Errorf("guard functionResponse name = %v", fr["name"])
+		}
+		if fr["id"] != "call_1" {
+			t.Errorf("guard functionResponse id = %v, want call_1", fr["id"])
+		}
+	} else {
+		t.Errorf("guard part is not a functionResponse: %v", last.Parts[0])
+	}
+}
+
+func TestEnsureGeminiTerminalUserTurn_TextModelTurnGetsNudge(t *testing.T) {
+	body := []byte(`{"contents":[
+		{"role":"user","parts":[{"text":"q"}]},
+		{"role":"model","parts":[{"text":"partial answer"}]}
+	]}`)
+	out := EnsureGeminiTerminalUserTurn(body)
+	if !strings.Contains(string(out), `"role":"user"`) {
+		t.Fatalf("no guard turn: %s", out)
+	}
+	var req struct {
+		Contents []struct {
+			Role  string `json:"role"`
+			Parts []struct {
+				Text string `json:"text"`
+			} `json:"parts"`
+		} `json:"contents"`
+	}
+	if err := json.Unmarshal(out, &req); err != nil {
+		t.Fatal(err)
+	}
+	last := req.Contents[len(req.Contents)-1]
+	if last.Role != "user" || len(last.Parts) == 0 || last.Parts[0].Text == "" {
+		t.Fatalf("guard nudge missing: %+v", last)
+	}
+}
+
+// A body already ending with user must pass through byte-identical.
+func TestEnsureGeminiTerminalUserTurn_UserLastUntouched(t *testing.T) {
+	body := []byte(`{"contents":[{"role":"user","parts":[{"text":"hi"}]}]}`)
+	if out := EnsureGeminiTerminalUserTurn(body); string(out) != string(body) {
+		t.Fatalf("user-last body rewritten: %s", out)
+	}
+}
+
+// Unknown top-level fields must survive (the struct round-trip lesson).
+func TestEnsureGeminiTerminalUserTurn_PreservesOtherKeys(t *testing.T) {
+	body := []byte(`{"systemInstruction":{"parts":[{"text":"sys"}]},
+		"tools":[{"functionDeclarations":[{"name":"f"}]}],
+		"contents":[
+			{"role":"user","parts":[{"text":"q"}]},
+			{"role":"model","parts":[{"text":"a"}]}
+		]}`)
+	out := EnsureGeminiTerminalUserTurn(body)
+	var doc map[string]jsontext.Value
+	if err := json.Unmarshal(out, &doc); err != nil {
+		t.Fatal(err)
+	}
+	if _, ok := doc["systemInstruction"]; !ok {
+		t.Error("systemInstruction dropped")
+	}
+	if _, ok := doc["tools"]; !ok {
+		t.Error("tools dropped")
+	}
+}
