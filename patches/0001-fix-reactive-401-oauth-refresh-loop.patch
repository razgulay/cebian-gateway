+// persistOAuthRefresh merges a refreshed OAuth token into the connection row in
+// ONE atomic statement — and CHECKS the result.
+//
+// Two defects this replaces (root of the reactive-401 refresh loop):
+//
+//   - The previous writers did read-modify-write in Go with the refresh HTTP
+//     call sitting between the row read and the row write, so any concurrent
+//     refresh, background tick, or projectId discovery that committed in that
+//     window was silently clobbered — the row reverted to the dead token.
+//   - The db.Exec error was discarded, so a failed persist looked identical to
+//     a successful one: every request reloaded the expired credential, hit 401,
+//     refreshed, and "succeeded" on the in-hand copy while the row never
+//     changed.
+//
+// The merge happens SQL-side via json_set (same pattern as
+// storeAntigravityProjectID), so concurrent writers cannot lose each other's
+// fields. refreshToken/projectId are only overwritten when non-empty (Google
+// omits refresh_token on refresh responses).
+func (h *ChatHandler) persistOAuthRefresh(connectionID string, result *oauth.TokenResult, projectID string) error {
+	if connectionID == "" || result == nil || result.AccessToken == "" {
+		return fmt.Errorf("persist OAuth refresh: missing connection id or access token")
+	}
+	expiresIn := result.ExpiresIn
+	if expiresIn <= 0 {
+		// Provider omitted expires_in: stamping expiresAt=now would mark the
+		// row permanently expired and re-select it for refresh forever
+		// (same fallback the background refresher applies).
+		expiresIn = 3600
+	}
+	expiresAt := time.Now().Add(time.Duration(expiresIn) * time.Second).UTC().Format(time.RFC3339)
+	res, err := h.Repo.RawDB().Exec(
+		`UPDATE providerConnections SET updatedAt = ?, data = json_set(data,
+			'$.accessToken', ?,
+			'$.expiresAt', ?,
+			'$.refreshToken', CASE WHEN ? != '' THEN ? ELSE json_extract(data, '$.refreshToken') END,
+			'$.projectId', CASE WHEN ? != '' THEN ? ELSE json_extract(data, '$.projectId') END)
+		WHERE id = ? AND json_valid(data)`,
+		time.Now().UTC().Format(time.RFC3339),
+		result.AccessToken, expiresAt,
+		result.RefreshToken, result.RefreshToken,
+		projectID, projectID,
+		connectionID,
+	)
+	if err != nil {
+		return fmt.Errorf("persist OAuth refresh for %s: %w", connectionID, err)
 	}
-	return tokenResp.AccessToken, pid, nil
+	if n, _ := res.RowsAffected(); n == 0 {
+		return fmt.Errorf("persist OAuth refresh for %s: connection row missing or data not valid JSON", connectionID)
+	}
