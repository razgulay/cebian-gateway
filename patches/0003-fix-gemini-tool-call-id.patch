diff --git a/internal/translator/gemini_toolid_test.go b/internal/translator/gemini_toolid_test.go
new file mode 100644
--- /dev/null
+++ b/internal/translator/gemini_toolid_test.go
@@ -0,0 +1,71 @@
+package translator
+
+import (
+	json "encoding/json/v2"
+	"testing"
+)
+
+// Regression tests for patches/0003: an OpenAI->Gemini request whose assistant
+// tool_calls carry an id must emit functionCall.id and functionResponse.id with
+// the SAME cleaned value. Google's Vertex-Anthropic converter rejects a
+// functionResponse whose id is missing or unmatched with
+// "messages.0.content.0.tool_result.tool_use_id: Field required".
+
+func geminiToolIDs(t *testing.T, openaiBody string) (callIDs, respIDs []string) {
+	t.Helper()
+	out, err := TranslateOpenAIToGemini([]byte(openaiBody))
+	if err != nil {
+		t.Fatalf("TranslateOpenAIToGemini: %v", err)
+	}
+	var req GeminiRequest
+	if err := json.Unmarshal(out, &req); err != nil {
+		t.Fatalf("unmarshal gemini request: %v", err)
+	}
+	for _, c := range req.Contents {
+		for _, p := range c.Parts {
+			if p.FunctionCall != nil {
+				callIDs = append(callIDs, p.FunctionCall.ID)
+			}
+			if p.FunctionResponse != nil {
+				respIDs = append(respIDs, p.FunctionResponse.ID)
+			}
+		}
+	}
+	return callIDs, respIDs
+}
+
+func TestOpenAIToGeminiCarriesToolCallID(t *testing.T) {
+	body := `{"model":"m","messages":[{"role":"user","content":"go"},{"role":"assistant","content":null,"tool_calls":[{"id":"call_abc123","type":"function","function":{"name":"fs_list","arguments":"{}"}}]},{"role":"tool","tool_call_id":"call_abc123","content":"[]"}]}`
+	calls, resps := geminiToolIDs(t, body)
+	if len(calls) != 1 || len(resps) != 1 {
+		t.Fatalf("calls=%v resps=%v", calls, resps)
+	}
+	if calls[0] != "call_abc123" || resps[0] != "call_abc123" {
+		t.Fatalf("id mismatch: call=%q resp=%q", calls[0], resps[0])
+	}
+}
+
+func TestOpenAIToGeminiRepairsMissingToolCallID(t *testing.T) {
+	body := `{"model":"m","messages":[{"role":"user","content":"go"},{"role":"assistant","content":null,"tool_calls":[{"type":"function","function":{"name":"fs_list","arguments":"{}"}}]},{"role":"tool","content":"[]"}]}`
+	calls, resps := geminiToolIDs(t, body)
+	if len(calls) != 1 || len(resps) != 1 {
+		t.Fatalf("calls=%v resps=%v", calls, resps)
+	}
+	if calls[0] == "" || resps[0] == "" {
+		t.Fatalf("id still empty: call=%q resp=%q", calls[0], resps[0])
+	}
+	if calls[0] != resps[0] {
+		t.Fatalf("repaired ids differ: call=%q resp=%q", calls[0], resps[0])
+	}
+}
+
+func TestOpenAIToGeminiStripsThoughtSigOnBothSides(t *testing.T) {
+	body := `{"model":"m","messages":[{"role":"user","content":"go"},{"role":"assistant","content":null,"tool_calls":[{"id":"call_x__ts__SIG123","type":"function","function":{"name":"fs_list","arguments":"{}"}}]},{"role":"tool","tool_call_id":"call_x__ts__SIG123","content":"[]"}]}`
+	calls, resps := geminiToolIDs(t, body)
+	if len(calls) != 1 || len(resps) != 1 {
+		t.Fatalf("calls=%v resps=%v", calls, resps)
+	}
+	if calls[0] != "call_x" || resps[0] != "call_x" {
+		t.Fatalf("thought-sig not stripped: call=%q resp=%q", calls[0], resps[0])
+	}
+}
