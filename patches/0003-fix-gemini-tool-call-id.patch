+// stripThoughtSig removes the "__ts__<sig>" suffix the response translator
+// encodes into a tool call ID (see TranslateGeminiResponseToOpenAI). Gemini
+// matches a functionResponse to its functionCall by id, so both sides must
+// carry the same cleaned value: emitting the raw id on one side and the
+// stripped one on the other turns every tool round-trip into a 400.
+func stripThoughtSig(id string) string {
+	const sep = "__ts__"
+	if before, _, ok := strings.CutLast(id, sep); ok {
+		return before
+	}
+	return id
+}
+
+// repairGeminiToolIDs fills in a missing tool_call_id / tool_calls[].id on a
+// raw OpenAI messages array. Without it an id-less pair reaches Gemini as a
+// functionResponse with no id, and Google's Vertex-Anthropic converter drops
+// tool_use_id and 400s the whole request (PR #4090 parity for the Gemini path).
+func repairGeminiToolIDs(raw jsontext.Value) jsontext.Value {
+	if len(raw) == 0 {
+		return raw
+	}
+	var msgs []map[string]any
+	if err := json.Unmarshal(raw, &msgs); err != nil {
+		return raw
+	}
+	var pending []string
+	seq := 0
+	changed := false
+	for i := range msgs {
+		role, _ := msgs[i]["role"].(string)
+		switch role {
+		case "assistant":
+			tcs, _ := msgs[i]["tool_calls"].([]any)
+			if len(tcs) == 0 {
+				continue
+			}
+			for k := range tcs {
+				tc, _ := tcs[k].(map[string]any)
+				if tc == nil {
+					continue
+				}
+				id, _ := tc["id"].(string)
+				if id == "" {
+					id = fmt.Sprintf("call_%d_%d", seq, k)
+					tc["id"] = id
+					changed = true
+				}
+				pending = append(pending, id)
+			}
+			seq++
+		case "tool":
+			id, _ := msgs[i]["tool_call_id"].(string)
+			if id == "" && len(pending) > 0 {
+				msgs[i]["tool_call_id"] = pending[0]
+				pending = pending[1:]
+				changed = true
+			} else if id != "" {
+				for j, p := range pending {
+					if p == id {
+						pending = append(pending[:j], pending[j+1:]...)
+						break
+					}
+				}
+			}
+		}
+	}
+	if !changed {
+		return raw
+	}
+	out, err := json.Marshal(msgs)
+	if err != nil {
+		return raw
+	}
+	return jsontext.Value(out)
+}
