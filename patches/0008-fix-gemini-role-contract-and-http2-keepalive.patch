diff --git a/internal/constants/transport.go b/internal/constants/transport.go
index 8a0df07..eb8d604 100644
--- a/internal/constants/transport.go
+++ b/internal/constants/transport.go
@@ -3,6 +3,25 @@ package constants
 import (
 	"net/http"
 	"time"
+
+	"golang.org/x/net/http2"
+)
+
+// HTTP/2 dead-connection probing. Upgrading through x/net/http2 exists ONLY
+// to tune these two: the default auto-upgrade (ForceAttemptHTTP2 alone)
+// leaves ReadIdleTimeout at 0, so a connection that goes silently dead —
+// NAT drop, half-open socket after a route change — is never probed and the
+// in-flight request hangs until an outer layer reports an unhelpful 502,
+// which on heavy prompts looks like a random timeout.
+const (
+	// HTTP2ReadIdleTimeout sends a PING when a connection has been silent
+	// this long. Must comfortably exceed the legitimate silent window of a
+	// long prompt thinking before its first SSE byte.
+	HTTP2ReadIdleTimeout = 2 * time.Minute
+	// HTTP2PingTimeout declares the connection dead when the PING is not
+	// acknowledged within this window; the request fails fast and the
+	// fallback chain can retry instead of hanging.
+	HTTP2PingTimeout = 30 * time.Second
 )
 
 // HTTPTransportConfig encapsulates connection pooling and timeout configurations
@@ -51,6 +70,48 @@ func (c HTTPTransportConfig) Configure(t *http.Transport) {
 	t.TLSHandshakeTimeout = c.TLSHandshakeTimeout
 	t.ExpectContinueTimeout = c.ExpectContinueTimeout
 	t.ResponseHeaderTimeout = c.ResponseHeaderTimeout
+	configureHTTP2(t)
+}
+
+// configureHTTP2 hands the transport to x/net/http2 so the keepalive tuning
+// above actually applies. ConfigureTransports is the supported way to both
+// enable h2 and keep a handle to the h2 stack; on error the transport keeps
+// its previous behaviour (auto-h2 with default settings).
+func configureHTTP2(t *http.Transport) {
+	if h2 := ApplyHTTP2Keepalive(t); h2 == nil {
+		// Not configurable (already wired by someone else, or nil) — the
+		// transport's own ForceAttemptHTTP2 still upgrades requests.
+		return
+	}
+}
+
+// ApplyHTTP2Keepalive upgrades t for HTTP/2 with the dead-connection probing
+// above and returns the h2 stack handle, or nil when the upgrade is refused
+// or already done. The already-done case matters: callers Configure the same
+// transport more than once (connections_proxy.go builds with NewTransport
+// then re-Configures), and a second ConfigureTransports panics with
+// "http: HTTP/2 Transport already registered" — x/net v0.58 registers via
+// RegisterProtocol, which refuses duplicate schemes, and may use either the
+// Protocols field or TLSNextProto depending on version.
+func ApplyHTTP2Keepalive(t *http.Transport) *http2.Transport {
+	if t == nil {
+		return nil
+	}
+	if t.Protocols != nil && t.Protocols.HTTP2() {
+		return nil
+	}
+	if t.TLSNextProto != nil {
+		if _, done := t.TLSNextProto["https"]; done {
+			return nil
+		}
+	}
+	h2, err := http2.ConfigureTransports(t)
+	if err != nil || h2 == nil {
+		return nil
+	}
+	h2.ReadIdleTimeout = HTTP2ReadIdleTimeout
+	h2.PingTimeout = HTTP2PingTimeout
+	return h2
 }
 
 // NewTransport instantiates a fresh *http.Transport with these settings applied and Proxy: nil.
