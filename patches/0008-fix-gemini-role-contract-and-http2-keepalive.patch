index 0000000..cf708e1
--- /dev/null
+++ b/internal/translator/gemini_role_contract_test.go
@@ -0,0 +1,112 @@
+package translator
+
+import (
+	"strings"
+	"testing"
+
+	json "encoding/json/v2"
+)
+
+// Regression tests for the role contract: Google's generateContent endpoints
+// accept ONLY roles "user" and "model" inside contents — anything else draws
+// 400 "Please use a valid role: user, model". System text belongs in the
+// top-level systemInstruction. NormalizeGeminiRequest is the funnel that
+// guarantees this for every Gemini-native payload the router sends.
+
+func TestNormalizeGeminiRequest_EnforcesRoleContract(t *testing.T) {
+	req := &GeminiRequest{
+		SystemInstruction: &GeminiContent{Role: "user", Parts: []GeminiPart{{Text: "existing instructions"}}},
+		Contents: []GeminiContent{
+			{Role: "system", Parts: []GeminiPart{{Text: "hoisted system text"}}},
+			{Role: "developer", Parts: []GeminiPart{{Text: "hoisted developer text"}}},
+			{Role: "user", Parts: []GeminiPart{{Text: "question"}}},
+			{Role: "assistant", Parts: []GeminiPart{{FunctionCall: &GeminiFunctionCall{Name: "f"}}}},
+			{Role: "assistant", Parts: []GeminiPart{{FunctionResponse: &GeminiFunctionResp{Name: "f"}}}},
+		},
+	}
+	NormalizeGeminiRequest(req)
+
+	if req.SystemInstruction == nil {
+		t.Fatal("systemInstruction missing")
+	}
+	var sysText string
+	for _, p := range req.SystemInstruction.Parts {
+		sysText += p.Text
+	}
+	if !strings.Contains(sysText, "existing instructions") || !strings.Contains(sysText, "hoisted system text") || !strings.Contains(sysText, "hoisted developer text") {
+		t.Fatalf("systemInstruction lost parts: %q", sysText)
+	}
+
+	for i, c := range req.Contents {
+		if c.Role != "user" && c.Role != "model" {
+			t.Errorf("contents[%d] role %q — only user/model allowed", i, c.Role)
+		}
+	}
+	// The user turn, then the call turn (assistant→model), then the response
+	// turn (functionResponse-bearing → user).
+	roles := make([]string, 0, len(req.Contents))
+	for _, c := range req.Contents {
+		roles = append(roles, c.Role)
+	}
+	joined := strings.Join(roles, ",")
+	if !strings.Contains(joined, "model") {
+		t.Errorf("assistant turn not canonicalized to model: %q", joined)
+	}
+	if !strings.Contains(joined, "user") {
+		t.Errorf("functionResponse turn not canonicalized to user: %q", joined)
+	}
+}
+
+// TranslateOpenAIToGemini must never place a system message inside contents.
+func TestTranslateOpenAIToGemini_SystemNeverInsideContents(t *testing.T) {
+	body := `{"model":"gemini-3-pro-preview","messages":[
+		{"role":"system","content":"be terse"},
+		{"role":"user","content":"hi"}
+	]}`
+	out, err := TranslateOpenAIToGemini([]byte(body))
+	if err != nil {
+		t.Fatalf("translate: %v", err)
+	}
+	var req GeminiRequest
+	if err := json.Unmarshal(out, &req); err != nil {
+		t.Fatal(err)
+	}
+	if req.SystemInstruction == nil || len(req.SystemInstruction.Parts) == 0 || req.SystemInstruction.Parts[0].Text != "be terse" {
+		t.Fatalf("system message not hoisted into systemInstruction: %s", out)
+	}
+	for _, c := range req.Contents {
+		if c.Role != "user" && c.Role != "model" {
+			t.Fatalf("contents role %q reached the payload", c.Role)
+		}
+	}
+}
+
+// WrapForAntigravity runs the same funnel over the wrapped body, so even a
+// hand-built Gemini payload cannot carry a foreign role to cloudcode-pa.
+func TestWrapForAntigravity_EnforcesRoleContract(t *testing.T) {
+	geminiBody := []byte(`{"contents":[
+		{"role":"system","parts":[{"text":"sys prompt"}]},
+		{"role":"user","parts":[{"text":"hi"}]},
+		{"role":"assistant","parts":[{"text":"hello"}]}
+	]}`)
+	wrapped, err := WrapForAntigravity(geminiBody, "proj-1", "gemini-3-pro-preview")
+	if err != nil {
+		t.Fatalf("wrap: %v", err)
+	}
+	var env AntigravityRequest
+	if err := json.Unmarshal(wrapped, &env); err != nil {
+		t.Fatal(err)
+	}
+	var req GeminiRequest
+	if err := json.Unmarshal(env.Request, &req); err != nil {
+		t.Fatal(err)
+	}
+	if req.SystemInstruction == nil || len(req.SystemInstruction.Parts) == 0 || req.SystemInstruction.Parts[0].Text != "sys prompt" {
+		t.Fatalf("system content not hoisted by WrapForAntigravity: %s", env.Request)
+	}
+	for i, c := range req.Contents {
+		if c.Role != "user" && c.Role != "model" {
+			t.Errorf("wrapped contents[%d] role %q — only user/model allowed", i, c.Role)
+		}
+	}
+}
