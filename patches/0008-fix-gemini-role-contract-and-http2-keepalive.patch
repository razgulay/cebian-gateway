 // arrive that way and would 400 without the guards.
+// NormalizeGeminiRequest enforces the role contract Google's generateContent
+// endpoints demand — the funnel every Gemini-native payload passes through
+// (TranslateOpenAIToGemini output, WrapForAntigravity re-wrap):
+//
+//   - "system"/"developer"-role contents are hoisted into the top-level
+//     systemInstruction instead of riding inside contents;
+//   - "assistant" is canonicalized to "model"; functionResponse-bearing
+//     contents to "user"; anything unknown to "user";
+//   - then the usual NormalizeGeminiContents cleanup (merge adjacent,
+//     strip empties, first turn user, terminal-model answer turn).
+//
+// Without this a converter regression or a hand-built Gemini body reached
+// Google with a foreign role and drew 400 "Please use a valid role: user,
+// model".
+func NormalizeGeminiRequest(req *GeminiRequest) {
+	if req == nil {
+		return
+	}
+	var sysParts []GeminiPart
+	kept := make([]GeminiContent, 0, len(req.Contents))
+	for _, c := range req.Contents {
+		switch strings.ToLower(c.Role) {
+		case "system", "developer":
+			sysParts = append(sysParts, c.Parts...)
+			continue
+		}
+		kept = append(kept, c)
+	}
+	if len(sysParts) > 0 {
+		if req.SystemInstruction != nil {
+			sysParts = append(req.SystemInstruction.Parts, sysParts...)
+		}
+		req.SystemInstruction = &GeminiContent{Role: "user", Parts: sysParts}
+	}
+	for i := range kept {
+		if kept[i].Role == "" {
+			// No role to reason about — NormalizeGeminiContents drops these,
+			// same as it always has.
+			continue
+		}
+		kept[i].Role = geminiCanonicalRole(kept[i].Role, kept[i].Parts)
+	}
+	req.Contents = NormalizeGeminiContents(kept)
+}
+
+// geminiCanonicalRole maps any incoming role to the two Google accepts.
+func geminiCanonicalRole(role string, parts []GeminiPart) string {
+	for _, p := range parts {
+		if p.FunctionResponse != nil {
+			// A function result is a user-side turn regardless of the label
+			// the converter gave it.
+			return "user"
+		}
+	}
+	switch strings.ToLower(role) {
+	case "model", "assistant":
+		return "model"
+	default:
+		return "user"
+	}
+}
