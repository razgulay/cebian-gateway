diff --git a/internal/proxy/vertex.go b/internal/proxy/vertex.go
new file mode 100644
index 0000000..b5497a4
--- /dev/null
+++ b/internal/proxy/vertex.go
@@ -0,0 +1,582 @@
+package proxy
+
+import (
+	"context"
+	"crypto"
+	"crypto/rand"
+	"crypto/rsa"
+	"crypto/sha256"
+	"crypto/x509"
+	"encoding/base64"
+	"encoding/pem"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"regexp"
+	"strings"
+	"sync"
+	"time"
+
+	json "encoding/json/v2"
+
+	"9router/proxy/internal/constants"
+	"9router/proxy/internal/log"
+	"9router/proxy/internal/providers"
+	"9router/proxy/internal/translator"
+)
+
+// Vertex AI forwarding — port of open-sse/executors/vertex.js.
+//
+// The Go catalog registered vertex/vertex-partner (models, aliases, dashboard)
+// but never ported the executor, so a chat request fell through to the generic
+// OpenAI path and POSTed verbatim to the registry BaseURL — bare
+// https://aiplatform.googleapis.com/v1 — which is Google's HTML
+// "404: The requested URL /v1 was not found on this server." for every model,
+// gemini-3.1-pro-preview included. This file supplies the missing lane:
+//
+//	vertex         → Gemini-native bodies against publishers/google/models
+//	vertex-partner → OpenAI-compatible bodies against
+//	                 /projects/{id}/locations/global/endpoints/openapi
+//
+// Auth (upstream parity, credentials stored as the connection apiKey):
+//   - Service Account JSON (type=service_account) → RS256 JWT assertion →
+//     Bearer via the oauth2 token endpoint, cached per client_email
+//   - ADC user JSON (type=authorized_user) → refresh_token grant, cached per
+//     refresh token
+//   - anything else → raw Vertex API key, sent as ?key= (express mode)
+//
+// A pre-set connection accessToken is used as the Bearer directly.
+
+const (
+	// vertexDefaultHost is the upstream registry baseUrl. Connections may
+	// carry an older override ending in /v1; vertexBaseHost strips it.
+	vertexDefaultHost = "https://aiplatform.googleapis.com"
+
+	googleOAuthTokenURL = "https://oauth2.googleapis.com/token"
+
+	vertexCloudPlatformScope = "https://www.googleapis.com/auth/cloud-platform"
+
+	// defaultVertexLocation mirrors buildUrl's fallback for OAuth calls.
+	defaultVertexLocation = "us-central1"
+)
+
+// DefaultVertexThinkingSignature is DEFAULT_THINKING_VERTEX_SIGNATURE from
+// open-sse/config/defaultThinkingSignature.js. Vertex rejects the synthetic
+// AG/Gemini-API signatures the request translator backfills, so every
+// thoughtSignature is replaced with this Vertex-native one
+// (openai-to-vertex.js postProcessForVertex).
+const DefaultVertexThinkingSignature = ""
+
+// vertexServiceAccount is the subset of a Google Service Account JSON key this
+// flow needs (parseVertexSaJson upstream).
+type vertexServiceAccount struct {
+	Type        string `json:"type"`
+	ClientEmail string `json:"client_email"`
+	PrivateKey  string `json:"private_key"`
+	ProjectID   string `json:"project_id"`
+}
+
+// vertexADC is the subset of `gcloud auth application-default login`
+// credentials (parseVertexAdcJson upstream).
+type vertexADC struct {
+	Type           string `json:"type"`
+	ClientID       string `json:"client_id"`
+	ClientSecret   string `json:"client_secret"`
+	RefreshToken   string `json:"refresh_token"`
+	QuotaProjectID string `json:"quota_project_id"`
+}
+
+func parseVertexServiceAccount(apiKey string) *vertexServiceAccount {
+	if apiKey == "" {
+		return nil
+	}
+	var sa vertexServiceAccount
+	if err := json.Unmarshal([]byte(apiKey), &sa); err != nil {
+		return nil
+	}
+	if sa.Type != "service_account" || sa.ClientEmail == "" || sa.PrivateKey == "" || sa.ProjectID == "" {
+		return nil
+	}
+	return &sa
+}
+
+func parseVertexADC(apiKey string) *vertexADC {
+	if apiKey == "" {
+		return nil
+	}
+	var adc vertexADC
+	if err := json.Unmarshal([]byte(apiKey), &adc); err != nil {
+		return nil
+	}
+	if adc.Type != "authorized_user" || adc.ClientID == "" || adc.ClientSecret == "" || adc.RefreshToken == "" {
+		return nil
+	}
+	return &adc
+}
+
+// vertexBaseHost reduces any stored BaseURL (upstream registry value, or an
+// older connection override like https://aiplatform.googleapis.com/v1) to the
+// bare host, so path building below owns the whole path.
+func vertexBaseHost(base string) string {
+	host := strings.TrimRight(base, "/")
+	for _, suffix := range []string{"/v1beta/openai", "/v1beta", "/v1"} {
+		host = strings.TrimSuffix(host, suffix)
+	}
+	if host == "" || !strings.HasPrefix(host, "http://") && !strings.HasPrefix(host, "https://") {
+		return vertexDefaultHost
+	}
+	return host
+}
+
+// vertexAuth is the resolved credential set for one request.
+type vertexAuth struct {
+	// bearer is the OAuth access token (SA-minted, ADC-refreshed, or the
+	// connection's pre-set accessToken). Empty for raw-key mode.
+	bearer string
+	// rawKey is the express-mode API key sent as ?key=. Empty for OAuth.
+	rawKey string
+	// projectID is required for every OAuth call and for vertex-partner.
+	projectID string
+	// location is the regional endpoint segment (OAuth calls only).
+	location string
+}
+
+func (a *vertexAuth) oauth() bool { return a.bearer != "" }
+
+// psdString pulls a string out of providerSpecificData.
+func psdString(psd map[string]any, key string) string {
+	if psd == nil {
+		return ""
+	}
+	s, _ := psd[key].(string)
+	return s
+}
+
+// resolveVertexAuth classifies the connection credential and mints/refreshes
+// the Bearer when the stored credential is an SA or ADC JSON.
+func resolveVertexAuth(ctx context.Context, client *http.Client, apiKey string, psd map[string]any) (*vertexAuth, error) {
+	auth := &vertexAuth{
+		location: psdString(psd, "location"),
+	}
+	if auth.location == "" {
+		auth.location = defaultVertexLocation
+	}
+	if pid := psdString(psd, "projectId"); pid != "" {
+		auth.projectID = pid
+	}
+
+	switch {
+	case parseVertexServiceAccount(apiKey) != nil:
+		sa := parseVertexServiceAccount(apiKey)
+		tok, err := mintVertexSAToken(ctx, client, sa)
+		if err != nil {
+			return nil, err
+		}
+		auth.bearer = tok
+		auth.projectID = sa.ProjectID
+	case parseVertexADC(apiKey) != nil:
+		adc := parseVertexADC(apiKey)
+		tok, err := refreshVertexADCToken(ctx, client, adc)
+		if err != nil {
+			return nil, err
+		}
+		auth.bearer = tok
+		if adc.QuotaProjectID != "" && auth.projectID == "" {
+			auth.projectID = adc.QuotaProjectID
+		}
+	default:
+		// Not JSON (or not a recognized credential shape): an explicit
+		// accessToken rides as Bearer, anything else is an express key.
+		if isLikelyAccessToken(apiKey) {
+			auth.bearer = apiKey
+		} else {
+			auth.rawKey = apiKey
+		}
+	}
+	return auth, nil
+}
+
+// isLikelyAccessToken reports whether apiKey looks like a pre-minted OAuth
+// bearer rather than an express-mode API key. Express keys are short
+// alphanumeric strings; every Google bearer shape (JWT or gcloud-printed
+// token) either carries dots or is too long for a key. Ambiguity is
+// harmless: a key sent as Bearer fails auth clearly, and upstream has the
+// same binary split.
+func isLikelyAccessToken(s string) bool {
+	return strings.Count(s, ".") >= 2 || len(s) > 120
+}
+
+// Token caches. Upstream keeps these in tokenRefresh.js with a 5-minute
+// early-expiry margin; entries are keyed by credential identity.
+type vertexCachedToken struct {
+	token     string
+	expiresAt time.Time
+}
+
+var (
+	vertexSATokenMu  sync.Mutex
+	vertexSATokens   = map[string]vertexCachedToken{} // client_email → token
+	vertexADCTokenMu sync.Mutex
+	vertexADCTokens  = map[string]vertexCachedToken{} // refresh_token → token
+)
+
+const vertexTokenRefreshLead = 5 * time.Minute
+
+func cachedVertexToken(m map[string]vertexCachedToken, mu *sync.Mutex, key string) string {
+	mu.Lock()
+	defer mu.Unlock()
+	e, ok := m[key]
+	if !ok || time.Now().After(e.expiresAt.Add(-vertexTokenRefreshLead)) {
+		return ""
+	}
+	return e.token
+}
+
+func storeVertexToken(m map[string]vertexCachedToken, mu *sync.Mutex, key, token string, expiresIn int) {
+	if expiresIn <= 0 {
+		expiresIn = 3600
+	}
+	mu.Lock()
+	m[key] = vertexCachedToken{token: token, expiresAt: time.Now().Add(time.Duration(expiresIn) * time.Second)}
+	mu.Unlock()
+}
+
+// signVertexJWT builds the RS256 assertion for the SA grant
+// (refreshVertexToken's jose SignJWT block).
+func signVertexJWT(sa *vertexServiceAccount, now time.Time) (string, error) {
+	// Upstream parity: private_key.replace(/\\n/g, "\n") — a key stored with
+	// double-escaped newlines still decodes; a JSON-parsed one (real newlines)
+	// is untouched.
+	keyPEM := strings.ReplaceAll(sa.PrivateKey, `\n`, "\n")
+	block, _ := pem.Decode([]byte(keyPEM))
+	if block == nil {
+		return "", fmt.Errorf("vertex: service account private_key is not valid PEM")
+	}
+	keyAny, err := x509.ParsePKCS8PrivateKey(block.Bytes)
+	if err != nil {
+		return "", fmt.Errorf("vertex: parse service account private key: %w", err)
+	}
+	key, ok := keyAny.(*rsa.PrivateKey)
+	if !ok {
+		return "", fmt.Errorf("vertex: service account private key is not RSA")
+	}
+
+	claim := func(v any) string {
+		b, _ := json.Marshal(v)
+		return base64.RawURLEncoding.EncodeToString(b)
+	}
+	iat := now.Unix()
+	header := claim(map[string]string{"alg": "RS256", "typ": "JWT"})
+	claims := claim(map[string]any{
+		"iss":   sa.ClientEmail,
+		"scope": vertexCloudPlatformScope,
+		"aud":   googleOAuthTokenURL,
+		"iat":   iat,
+		"exp":   iat + 3600,
+	})
+	signingInput := header + "." + claims
+	digest := sha256.Sum256([]byte(signingInput))
+	sig, err := rsa.SignPKCS1v15(rand.Reader, key, crypto.SHA256, digest[:])
+	if err != nil {
+		return "", fmt.Errorf("vertex: sign JWT: %w", err)
+	}
+	return signingInput + "." + base64.RawURLEncoding.EncodeToString(sig), nil
+}
+
+func mintVertexSAToken(ctx context.Context, client *http.Client, sa *vertexServiceAccount) (string, error) {
+	if tok := cachedVertexToken(vertexSATokens, &vertexSATokenMu, sa.ClientEmail); tok != "" {
+		return tok, nil
+	}
+	jwt, err := signVertexJWT(sa, time.Now())
+	if err != nil {
+		return "", err
+	}
+	form := url.Values{
+		"grant_type": {"urn:ietf:params:oauth:grant-type:jwt-bearer"},
+		"assertion":  {jwt},
+	}
+	tok, expiresIn, err := postGoogleTokenEndpoint(ctx, client, form)
+	if err != nil {
+		return "", fmt.Errorf("vertex: failed to mint access token from Service Account JSON: %w", err)
+	}
+	storeVertexToken(vertexSATokens, &vertexSATokenMu, sa.ClientEmail, tok, expiresIn)
+	return tok, nil
+}
+
+func refreshVertexADCToken(ctx context.Context, client *http.Client, adc *vertexADC) (string, error) {
+	if tok := cachedVertexToken(vertexADCTokens, &vertexADCTokenMu, adc.RefreshToken); tok != "" {
+		return tok, nil
+	}
+	form := url.Values{
+		"grant_type":    {"refresh_token"},
+		"refresh_token": {adc.RefreshToken},
+		"client_id":     {adc.ClientID},
+		"client_secret": {adc.ClientSecret},
+	}
+	tok, expiresIn, err := postGoogleTokenEndpoint(ctx, client, form)
+	if err != nil {
+		return "", fmt.Errorf("vertex: failed to refresh access token from ADC JSON (authorized_user): %w", err)
+	}
+	storeVertexToken(vertexADCTokens, &vertexADCTokenMu, adc.RefreshToken, tok, expiresIn)
+	return tok, nil
+}
+
+func postGoogleTokenEndpoint(ctx context.Context, client *http.Client, form url.Values) (token string, expiresIn int, err error) {
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, googleOAuthTokenURL,
+		strings.NewReader(form.Encode()))
+	if err != nil {
+		return "", 0, err
+	}
+	req.Header.Set("Content-Type", "application/x-www-form-urlencoded")
+	if client == nil {
+		client = http.DefaultClient
+	}
+	resp, err := client.Do(req)
+	if err != nil {
+		return "", 0, err
+	}
+	defer resp.Body.Close()
+	body, err := io.ReadAll(io.LimitReader(resp.Body, constants.UpstreamErrLimit))
+	if err != nil {
+		return "", 0, err
+	}
+	if resp.StatusCode != http.StatusOK {
+		return "", 0, fmt.Errorf("token endpoint returned %d: %s", resp.StatusCode, truncateErrBody(body))
+	}
+	var parsed struct {
+		AccessToken string `json:"access_token"`
+		ExpiresIn   int    `json:"expires_in"`
+	}
+	if err := json.Unmarshal(body, &parsed); err != nil {
+		return "", 0, fmt.Errorf("parse token response: %w", err)
+	}
+	if parsed.AccessToken == "" {
+		return "", 0, fmt.Errorf("empty access token in refresh response")
+	}
+	return parsed.AccessToken, parsed.ExpiresIn, nil
+}
+
+func truncateErrBody(b []byte) string {
+	if len(b) > 500 {
+		return string(b[:500])
+	}
+	return string(b)
+}
+
+// ── Project ID resolution (vertex-partner raw keys) ─────────────────────────
+
+var vertexProjectRe = regexp.MustCompile(`projects/([^/]+)/`)
+
+var (
+	vertexProjectMu    sync.Mutex
+	vertexProjectCache = map[string]string{} // raw key → project id
+)
+
+// resolveVertexProjectID ports resolveProjectId: express keys don't carry a
+// project, so a deliberately-invalid probe request is sent and the project is
+// parsed out of Google's error text.
+func resolveVertexProjectID(ctx context.Context, client *http.Client, rawKey string) (string, error) {
+	vertexProjectMu.Lock()
+	pid := vertexProjectCache[rawKey]
+	vertexProjectMu.Unlock()
+	if pid != "" {
+		return pid, nil
+	}
+
+	probeURL := vertexDefaultHost + "/v1/publishers/google/models/__probe__:generateContent?key=" + url.QueryEscape(rawKey)
+	resp, err := DoRequest(ctx, client, http.MethodPost, probeURL, map[string]string{"Content-Type": "application/json"}, []byte("{}"))
+	if err != nil {
+		return "", fmt.Errorf("vertex: project probe request failed: %w", err)
+	}
+	body, _ := io.ReadAll(io.LimitReader(resp.Body, constants.UpstreamErrLimit))
+	resp.Body.Close()
+	var parsed struct {
+		Error struct {
+			Message string `json:"message"`
+		} `json:"error"`
+	}
+	_ = json.Unmarshal(body, &parsed)
+	if m := vertexProjectRe.FindStringSubmatch(parsed.Error.Message); m != nil {
+		vertexProjectMu.Lock()
+		vertexProjectCache[rawKey] = m[1]
+		vertexProjectMu.Unlock()
+		return m[1], nil
+	}
+	return "", fmt.Errorf("vertex: could not resolve project_id from API key. Please add it manually in provider settings")
+}
+
+// ── URL builders (buildUrl parity) ──────────────────────────────────────────
+
+// vertexGeminiURL builds the generateContent URL for provider "vertex".
+// OAuth credentials must use the project-scoped regional path
+// (RESOURCE_PROJECT_INVALID otherwise); express keys use the global
+// publishers endpoint with ?key=.
+func vertexGeminiURL(host string, model string, isStream bool, auth *vertexAuth) string {
+	action := "generateContent"
+	if isStream {
+		action = "streamGenerateContent"
+	}
+	if auth.oauth() {
+		u := fmt.Sprintf("%s/v1/projects/%s/locations/%s/publishers/google/models/%s:%s",
+			host, auth.projectID, auth.location, model, action)
+		if isStream {
+			u += "?alt=sse"
+		}
+		return u
+	}
+	u := fmt.Sprintf("%s/v1/publishers/google/models/%s:%s", host, model, action)
+	sep := "?"
+	if isStream {
+		u += "?alt=sse"
+		sep = "&"
+	}
+	if auth.rawKey != "" {
+		u += sep + "key=" + url.QueryEscape(auth.rawKey)
+	}
+	return u
+}
+
+// VertexPartnerChatURL builds the OpenAI-compatible endpoint for provider
+// "vertex-partner" (global openapi endpoint). Partner models require a
+// project id regardless of auth method.
+func VertexPartnerChatURL(host string, auth *vertexAuth) (string, error) {
+	if auth.projectID == "" {
+		return "", fmt.Errorf("vertex-partner: could not resolve project_id from API key. Please add it manually in provider settings")
+	}
+	u := fmt.Sprintf("%s/v1/projects/%s/locations/global/endpoints/openapi/chat/completions", host, auth.projectID)
+	if auth.rawKey != "" {
+		u += "?key=" + url.QueryEscape(auth.rawKey)
+	}
+	return u, nil
+}
+
+// ── Request body post-processing (openai-to-vertex.js parity) ───────────────
+
+// postProcessVertexBody adapts a Gemini-format body to Vertex: replace every
+// thoughtSignature with the Vertex-native one and strip the id from
+// functionCall/functionResponse parts (Vertex rejects ids).
+func postProcessVertexBody(body []byte) []byte {
+	var parsed struct {
+		Contents []struct {
+			Parts []map[string]any `json:"parts"`
+		} `json:"contents"`
+	}
+	if err := json.Unmarshal(body, &parsed); err != nil {
+		return body
+	}
+	changed := false
+	for _, turn := range parsed.Contents {
+		for _, part := range turn.Parts {
+			// Only rewrite on a real difference: a body that is already
+			// Vertex-processed (default signature, ids gone) must pass through
+			// byte-identical, not be re-serialized on every request.
+			if sig, ok := part["thoughtSignature"].(string); ok && sig != DefaultVertexThinkingSignature {
+				part["thoughtSignature"] = DefaultVertexThinkingSignature
+				changed = true
+			}
+			if fc, ok := part["functionCall"].(map[string]any); ok {
+				if _, has := fc["id"]; has {
+					delete(fc, "id")
+					changed = true
+				}
+			}
+			if fr, ok := part["functionResponse"].(map[string]any); ok {
+				if _, has := fr["id"]; has {
+					delete(fr, "id")
+					changed = true
+				}
+			}
+		}
+	}
+	if !changed {
+		return body
+	}
+	out, err := json.Marshal(parsed)
+	if err != nil {
+		return body
+	}
+	return out
+}
+
+// ── Entry points ────────────────────────────────────────────────────────────
+
+// PrepareVertexPartner resolves credentials for provider "vertex-partner" and
+// returns the final chat URL plus the credential the generic OpenAI forwarder
+// must send: the Bearer token for OAuth lanes, or "" (the key rides in the
+// URL, so the caller marks the config NoAuth).
+func PrepareVertexPartner(ctx context.Context, client *http.Client, cfg *providers.ProviderConfig, apiKey string, psd map[string]any) (finalURL, bearer string, err error) {
+	auth, err := resolveVertexAuth(ctx, client, apiKey, psd)
+	if err != nil {
+		return "", "", err
+	}
+	if !auth.oauth() && auth.rawKey != "" && auth.projectID == "" {
+		// Express key without a hand-set project: probe once, cache forever.
+		pid, perr := resolveVertexProjectID(ctx, client, auth.rawKey)
+		if perr != nil {
+			return "", "", perr
+		}
+		auth.projectID = pid
+	}
+	finalURL, err = VertexPartnerChatURL(vertexBaseHost(cfg.BaseURL), auth)
+	if err != nil {
+		return "", "", err
+	}
+	return finalURL, auth.bearer, nil
+}
+
+// ForwardVertex sends an OpenAI-format request to Vertex AI (provider
+// "vertex") as a Gemini-native generateContent call, returning the upstream
+// response. Non-200 answers come back as *UpstreamError.
+func ForwardVertex(ctx context.Context, client *http.Client, cfg *providers.ProviderConfig, apiKey string, body []byte, isStream bool, modelName string, psd map[string]any) (*http.Response, error) {
+	if modelName == "" {
+		// Extract model from the OpenAI body when the caller didn't say.
+		var reqMeta struct {
+			Model string `json:"model"`
+		}
+		if err := json.Unmarshal(body, &reqMeta); err == nil {
+			modelName = reqMeta.Model
+		}
+	}
+
+	auth, err := resolveVertexAuth(ctx, client, apiKey, psd)
+	if err != nil {
+		return nil, err
+	}
+	if auth.oauth() && auth.projectID == "" {
+		return nil, fmt.Errorf("vertex: OAuth/ADC requires a project_id. Add quota_project_id to your ADC JSON or set providerSpecificData.projectId")
+	}
+
+	geminiBody, err := translator.TranslateOpenAIToGemini(body)
+	if err != nil {
+		return nil, fmt.Errorf("translate to Gemini: %w", err)
+	}
+	sendBody := postProcessVertexBody(geminiBody)
+
+	requestURL := vertexGeminiURL(vertexBaseHost(cfg.BaseURL), modelName, isStream, auth)
+
+	headers := map[string]string{
+		"Content-Type": "application/json",
+	}
+	if auth.oauth() {
+		headers["Authorization"] = "Bearer " + auth.bearer
+	}
+	if isStream {
+		headers["Accept"] = "text/event-stream"
+	}
+
+	resp, err := DoRequest(ctx, client, http.MethodPost, requestURL, headers, sendBody)
+	if err != nil {
+		return nil, fmt.Errorf("upstream request: %w", err)
+	}
+	if resp.StatusCode != http.StatusOK {
+		errBody, readErr := io.ReadAll(io.LimitReader(resp.Body, constants.UpstreamErrLimit))
+		resp.Body.Close()
+		if readErr != nil {
+			return nil, fmt.Errorf("upstream returned %d and body read failed: %w", resp.StatusCode, readErr)
+		}
+		log.Warn("vertex", "upstream error", "model", modelName, "status", resp.StatusCode, "body", truncateErrBody(errBody))
+		return nil, &UpstreamError{StatusCode: resp.StatusCode, Body: errBody, Header: resp.Header}
+	}
+	return resp, nil
+}
