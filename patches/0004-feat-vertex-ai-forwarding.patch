+package proxy
+
+import (
+	"strings"
+	"testing"
+
+	json "encoding/json/v2"
+	"encoding/json/jsontext"
+)
+
+// Tests for patches/0004: the vertex/vertex-partner forwarding lane. Without
+// it the generic OpenAI forwarder POSTed the registry BaseURL verbatim and
+// Google answered with its HTML "404: The requested URL /v1 was not found"
+// page for every Vertex model (gemini-3.1-pro-preview included).
+
+func TestVertexBaseHostStripsVersionSuffixes(t *testing.T) {
+	cases := []struct{ in, want string }{
+		{"https://aiplatform.googleapis.com", "https://aiplatform.googleapis.com"},
+		{"https://aiplatform.googleapis.com/", "https://aiplatform.googleapis.com"},
+		{"https://aiplatform.googleapis.com/v1", "https://aiplatform.googleapis.com"},
+		{"https://aiplatform.googleapis.com/v1/", "https://aiplatform.googleapis.com"},
+		{"https://aiplatform.googleapis.com/v1beta", "https://aiplatform.googleapis.com"},
+		{"https://aiplatform.googleapis.com/v1beta/openai", "https://aiplatform.googleapis.com"},
+		// Overrides pointing at generativelanguage still get a sane host.
+		{"https://generativelanguage.googleapis.com/v1beta/openai", "https://generativelanguage.googleapis.com"},
+		{"", vertexDefaultHost},
+		{"not a url", vertexDefaultHost},
+	}
+	for _, c := range cases {
+		if got := vertexBaseHost(c.in); got != c.want {
+			t.Errorf("vertexBaseHost(%q) = %q, want %q", c.in, got, c.want)
+		}
+	}
+}
+
+func TestParseVertexServiceAccountShape(t *testing.T) {
+	ok := `{"type":"service_account","client_email":"sa@proj.iam.gserviceaccount.com","private_key":"-----BEGIN PRIVATE KEY-----\nX\n-----END PRIVATE KEY-----\n","project_id":"proj-1"}`
+	if sa := parseVertexServiceAccount(ok); sa == nil {
+		t.Fatal("valid SA JSON rejected")
+	} else if sa.ProjectID != "proj-1" || sa.ClientEmail != "sa@proj.iam.gserviceaccount.com" {
+		t.Fatalf("parsed fields wrong: %+v", sa)
+	}
+	bad := []string{
+		"",
+		"raw-vertex-api-key",
+		`{"type":"authorized_user","client_id":"a","client_secret":"b","refresh_token":"c"}`,
+		`{"type":"service_account","client_email":"sa@proj.iam.gserviceaccount.com","private_key":"key"}`, // no project_id
+	}
+	for _, b := range bad {
+		if sa := parseVertexServiceAccount(b); sa != nil {
+			t.Errorf("parseVertexServiceAccount(%q) accepted invalid input", b)
+		}
+	}
+}
+
+func TestParseVertexADCShape(t *testing.T) {
+	ok := `{"type":"authorized_user","client_id":"cid","client_secret":"sec","refresh_token":"rt","quota_project_id":"qp"}`
+	if adc := parseVertexADC(ok); adc == nil {
+		t.Fatal("valid ADC JSON rejected")
+	} else if adc.QuotaProjectID != "qp" {
+		t.Fatalf("quota project lost: %+v", adc)
+	}
+	if adc := parseVertexADC(`{"type":"service_account","client_email":"e","private_key":"k","project_id":"p"}`); adc != nil {
+		t.Fatal("SA JSON accepted as ADC")
+	}
+}
+
+func TestVertexGeminiURLExpressKey(t *testing.T) {
+	auth := &vertexAuth{rawKey: "AIzakey/+"}
+	got := vertexGeminiURL("https://aiplatform.googleapis.com", "gemini-3.1-pro-preview", false, auth)
+	want := "https://aiplatform.googleapis.com/v1/publishers/google/models/gemini-3.1-pro-preview:generateContent?key=AIzakey%2F%2B"
+	if got != want {
+		t.Fatalf("non-stream express URL = %q, want %q", got, want)
+	}
+	got = vertexGeminiURL("https://aiplatform.googleapis.com", "gemini-3.1-pro-preview", true, auth)
+	want = "https://aiplatform.googleapis.com/v1/publishers/google/models/gemini-3.1-pro-preview:streamGenerateContent?alt=sse&key=AIzakey%2F%2B"
+	if got != want {
+		t.Fatalf("stream express URL = %q, want %q", got, want)
+	}
+}
+
+func TestVertexGeminiURLOAuthProjectScoped(t *testing.T) {
+	auth := &vertexAuth{bearer: "tok", projectID: "proj-9", location: "europe-west4"}
+	got := vertexGeminiURL("https://aiplatform.googleapis.com", "gemini-3.1-pro-preview", false, auth)
+	want := "https://aiplatform.googleapis.com/v1/projects/proj-9/locations/europe-west4/publishers/google/models/gemini-3.1-pro-preview:generateContent"
+	if got != want {
+		t.Fatalf("oauth URL = %q, want %q", got, want)
+	}
+	got = vertexGeminiURL("https://aiplatform.googleapis.com", "gemini-3.1-pro-preview", true, auth)
+	if !strings.HasSuffix(got, "?alt=sse") {
+		t.Fatalf("stream oauth URL missing ?alt=sse: %q", got)
+	}
+	if strings.Contains(got, "key=") {
+		t.Fatalf("oauth URL must not carry a key param: %q", got)
+	}
+}
+
+func TestVertexPartnerChatURL(t *testing.T) {
+	auth := &vertexAuth{bearer: "tok", projectID: "proj-9"}
+	got, err := VertexPartnerChatURL("https://aiplatform.googleapis.com", auth)
+	if err != nil {
+		t.Fatalf("oauth partner URL: %v", err)
+	}
+	want := "https://aiplatform.googleapis.com/v1/projects/proj-9/locations/global/endpoints/openapi/chat/completions"
+	if got != want {
+		t.Fatalf("partner oauth URL = %q, want %q", got, want)
+	}
+
+	raw := &vertexAuth{rawKey: "k", projectID: "proj-9"}
+	got, err = VertexPartnerChatURL("https://aiplatform.googleapis.com", raw)
+	if err != nil || !strings.HasSuffix(got, "?key=k") {
+		t.Fatalf("partner raw URL = %q err=%v", got, err)
+	}
+
+	noProject := &vertexAuth{rawKey: "k"}
+	if _, err := VertexPartnerChatURL("https://aiplatform.googleapis.com", noProject); err == nil {
+		t.Fatal("partner URL without project must error")
+	}
+}
+
+// postProcessVertexBody must mirror openai-to-vertex.js: replace every
+// thoughtSignature with the Vertex default and strip functionCall /
+// functionResponse ids.
+func TestPostProcessVertexBodyStripsIDsAndReplacesSignature(t *testing.T) {
+	in := []byte(`{"contents":[
+		{"role":"model","parts":[{"functionCall":{"name":"fs_read","id":"call_1","args":{"p":1}},"thoughtSignature":"AGSIG"}]},
+		{"role":"user","parts":[{"functionResponse":{"name":"fs_read","id":"call_1","response":{"result":"ok"}}}]}
+	]}`)
+	out := postProcessVertexBody(in)
+
+	var body struct {
+		Contents []struct {
+			Parts []jsontext.Value `json:"parts"`
+		} `json:"contents"`
+	}
+	if err := json.Unmarshal(out, &body); err != nil {
+		t.Fatalf("reparse: %v", err)
+	}
+	if len(body.Contents) != 2 {
+		t.Fatalf("contents lost: %s", out)
+	}
+
+	var callPart, respPart map[string]any
+	if err := json.Unmarshal([]byte(body.Contents[0].Parts[0]), &callPart); err != nil {
+		t.Fatal(err)
+	}
+	if err := json.Unmarshal([]byte(body.Contents[1].Parts[0]), &respPart); err != nil {
+		t.Fatal(err)
+	}
+
+	if sig, _ := callPart["thoughtSignature"].(string); sig != DefaultVertexThinkingSignature {
+		t.Fatalf("thoughtSignature not replaced with vertex default: %.40s", sig)
+	}
+	call, _ := callPart["functionCall"].(map[string]any)
+	if call == nil {
+		t.Fatalf("functionCall lost: %v", callPart)
+	}
+	if _, has := call["id"]; has {
+		t.Fatalf("functionCall.id not stripped: %v", call)
+	}
+	if call["name"] != "fs_read" {
+		t.Fatalf("functionCall.name lost: %v", call)
+	}
+	resp, _ := respPart["functionResponse"].(map[string]any)
+	if resp == nil {
+		t.Fatalf("functionResponse lost: %v", respPart)
+	}
+	if _, has := resp["id"]; has {
+		t.Fatalf("functionResponse.id not stripped: %v", resp)
+	}
+
+	// Idempotent: a second pass must not change anything.
+	if again := postProcessVertexBody(out); string(again) != string(out) {
+		t.Fatalf("postProcess not idempotent:\n once=%s\n twice=%s", out, again)
+	}
+}
+
+func TestPostProcessVertexBodyUntouchedWithoutMarkers(t *testing.T) {
+	in := []byte(`{"contents":[{"role":"user","parts":[{"text":"hi"}]}]}`)
+	if out := postProcessVertexBody(in); string(out) != string(in) {
+		t.Fatalf("clean body was rewritten: %s", out)
+	}
+}
+
+func TestSignVertexJWTShape(t *testing.T) {
+	// An RSA key generated for the test — 2048-bit PKCS#8 PEM with literal
+	// \n escapes exactly as a Service Account JSON stores it.
+	pemKey := generateTestRSAPrivateKeyPEM(t)
+	sa := &vertexServiceAccount{
+		Type:        "service_account",
+		ClientEmail: "sa@proj.iam.gserviceaccount.com",
+		PrivateKey:  strings.ReplaceAll(pemKey, "\n", "\\n"),
+		ProjectID:   "proj-1",
+	}
+	jwt, err := signVertexJWT(sa, testNow())
+	if err != nil {
+		t.Fatalf("signVertexJWT: %v", err)
+	}
+	parts := strings.Split(jwt, ".")
+	if len(parts) != 3 {
+		t.Fatalf("jwt has %d parts, want 3", len(parts))
+	}
+	var header struct {
+		Alg string `json:"alg"`
+		Typ string `json:"typ"`
+	}
+	var claims struct {
+		Iss   string `json:"iss"`
+		Scope string `json:"scope"`
+		Aud   string `json:"aud"`
+		Exp   int64  `json:"exp"`
+		Iat   int64  `json:"iat"`
+	}
+	decode := func(s string, v any) {
+		t.Helper()
+		raw, err := base64RawURLDecode(s)
+		if err != nil {
+			t.Fatalf("decode segment: %v", err)
+		}
+		if err := json.Unmarshal(raw, v); err != nil {
+			t.Fatalf("unmarshal segment %s: %v", s, v)
+		}
+	}
+	decode(parts[0], &header)
+	decode(parts[1], &claims)
+	if header.Alg != "RS256" || header.Typ != "JWT" {
+		t.Fatalf("header = %+v", header)
+	}
+	if claims.Iss != sa.ClientEmail || claims.Aud != googleOAuthTokenURL {
+		t.Fatalf("claims = %+v", claims)
+	}
+	if claims.Scope != vertexCloudPlatformScope {
+		t.Fatalf("scope = %q", claims.Scope)
+	}
+	if claims.Exp-claims.Iat != 3600 {
+		t.Fatalf("exp-iat = %d, want 3600", claims.Exp-claims.Iat)
+	}
+}
