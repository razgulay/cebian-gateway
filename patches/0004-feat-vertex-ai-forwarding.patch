diff --git a/internal/handlers/chat/vertex_handler.go b/internal/handlers/chat/vertex_handler.go
new file mode 100644
index 0000000..c425f0f
--- /dev/null
+++ b/internal/handlers/chat/vertex_handler.go
@@ -0,0 +1,110 @@
+package chat
+
+import (
+	"context"
+	"io"
+	"net/http"
+	"strings"
+
+	"9router/proxy/internal/log"
+	"9router/proxy/internal/providers"
+	"9router/proxy/internal/proxy"
+)
+
+// isVertexProvider reports whether provider is the Vertex AI family. Both
+// providers ship a catalog entry (models, aliases vx/vxp) but no executor,
+// so without this branch they fall through to the generic OpenAI forwarder,
+// which POSTs the registry BaseURL verbatim — bare
+// https://aiplatform.googleapis.com — and collects Google's HTML
+// "404: The requested URL /v1 was not found" for every model.
+func isVertexProvider(provider string) bool {
+	return provider == "vertex" || provider == "vertex-partner"
+}
+
+// forwardVertexRequest routes one request to Vertex AI.
+//
+//	vertex: Gemini-native bodies; the response is Gemini-native too, so the
+//	        same handlers the antigravity lane uses translate it back.
+//	vertex-partner: an OpenAI-compatible endpoint behind a project-scoped
+//	        path — credentials are resolved here, then the generic
+//	        forwardRequest runs with the final URL baked into a cloned config.
+func (h *ChatHandler) forwardVertexRequest(
+	ctx context.Context,
+	w http.ResponseWriter,
+	provider string,
+	providerCfg *providers.ProviderConfig,
+	apiKey string,
+	body []byte,
+	isStream bool,
+	translateResponse bool,
+	metrics *streamMetrics,
+	httpClient *http.Client,
+	modelName string,
+	psd map[string]any,
+) error {
+	if provider == "vertex-partner" {
+		return h.forwardVertexPartnerRequest(ctx, w, providerCfg, apiKey, body, isStream, translateResponse, metrics, httpClient, psd)
+	}
+
+	resp, err := proxy.ForwardVertex(ctx, httpClient, providerCfg, apiKey, body, isStream, modelName, psd)
+	if err != nil {
+		return err
+	}
+
+	var bodyCloser io.Closer = resp.Body
+	defer func() {
+		if bodyCloser != nil {
+			bodyCloser.Close()
+		}
+	}()
+
+	// Vertex answers generateContent with plain Gemini JSON (no antigravity
+	// {"response": ...} wrapper) and streamGenerateContent?alt=sse with
+	// Gemini SSE — the same shapes the gemini-native handlers consume.
+	if isStream {
+		contentType := resp.Header.Get("Content-Type")
+		if !strings.HasPrefix(strings.ToLower(contentType), "text/event-stream") {
+			return h.handleGeminiNonStream(ctx, w, resp.Body, translateResponse, metrics)
+		}
+		stallReader := proxy.NewStallReaderWithContext(ctx, resp.Body, 0, provider)
+		bodyCloser = stallReader
+		return h.handleGeminiStream(ctx, w, stallReader, translateResponse, metrics)
+	}
+	return h.handleGeminiNonStream(ctx, w, resp.Body, translateResponse, metrics)
+}
+
+// forwardVertexPartnerRequest resolves the Vertex credential + project, then
+// delegates to the generic OpenAI forwarder pointed at the partner endpoint.
+func (h *ChatHandler) forwardVertexPartnerRequest(
+	ctx context.Context,
+	w http.ResponseWriter,
+	providerCfg *providers.ProviderConfig,
+	apiKey string,
+	body []byte,
+	isStream bool,
+	translateResponse bool,
+	metrics *streamMetrics,
+	httpClient *http.Client,
+	psd map[string]any,
+) error {
+	finalURL, bearer, err := proxy.PrepareVertexPartner(ctx, httpClient, providerCfg, apiKey, psd)
+	if err != nil {
+		return err
+	}
+
+	cfg := *providerCfg
+	cfg.BaseURL = finalURL
+	key := apiKey
+	if bearer != "" {
+		// OAuth lane: send the minted Bearer, not the stored credential.
+		cfg.AuthHeader = "Authorization"
+		cfg.AuthScheme = "bearer"
+		cfg.NoAuth = false
+		key = bearer
+	} else {
+		// Express key: already in the URL query — no auth header.
+		cfg.NoAuth = true
+	}
+	log.Debug("vertex", "partner request", "url", finalURL)
+	return h.forwardRequest(ctx, w, &cfg, key, body, isStream, translateResponse, metrics, httpClient)
+}
